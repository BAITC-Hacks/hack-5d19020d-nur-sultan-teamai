# Copy to .env and fill in real values. Never commit .env.

# Actual API keys, not credit redemption URLs. Never commit .env.
OPENAI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-nano-3-30b-a3b
# Local cumulative planner cap (USD accounting reserve; not provider balance).
WIND_LLM_BUDGET_USD=2.00
